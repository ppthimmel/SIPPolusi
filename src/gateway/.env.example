# Owner: infra. NGINX API Gateway: public entry point in front of the Cache API.
# The upstream is scheme://host:port, no path or trailing slash.
# CACHE_API_UPSTREAM: POST /v1/routes and GET /v1/exposure-surface, the whole
# public API (service built from src/backend/osm/Dockerfile).
# Railway: http://${{cache-api.RAILWAY_PRIVATE_DOMAIN}}:${{cache-api.PORT}} (use the service's actual name)
CACHE_API_UPSTREAM=http://cache_api:8000
# GATEWAY_UPSTREAM_TIMEOUT_S: proxy read/send timeout in seconds (1-300). Default 10
# (Table 3.15). Raise only together with the Cache API and frontend timeouts (README).
# GATEWAY_UPSTREAM_TIMEOUT_S=10
