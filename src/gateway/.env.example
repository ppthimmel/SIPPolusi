# Owner: infra. NGINX API Gateway: public entry point in front of the backend.
# Upstreams are scheme://host:port, no path or trailing slash.
# BACKEND_UPSTREAM: /v1/* (e.g. /v1/routes).
# Railway: http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}} (private network)
BACKEND_UPSTREAM=http://backend:8000
# CACHE_API_UPSTREAM: /v1/osm/* and /v1/pollution/* (service built from src/backend/osm/Dockerfile).
# Railway: http://${{cache-api.RAILWAY_PRIVATE_DOMAIN}}:${{cache-api.PORT}} (use the service's actual name)
CACHE_API_UPSTREAM=http://cache_api:8000
