      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}} {{probe}}",
          "refId": "A"
        }
