# Owner: data worker. Writes pollution/osm cache schemas; reads models and features.
DATABASE_URL=postgresql://sippolusi:change-me@postgres:5432/sippolusi
# Models come through the registry's artifact proxy: no S3 endpoint or keys here (as on Railway).
MLFLOW_TRACKING_URI=http://model_registry:5000
SPATIAL_PM25_MODEL=spatial-downscaling-pm25
SPATIAL_NO2_MODEL=spatial-downscaling-no2
SPATIAL_PM25_VERSION=production
SPATIAL_NO2_VERSION=production
SPATIAL_MODEL_CACHE=/app/model-cache
# Model features come from the live feature store (schema features), as on Railway. Set
# SPATIAL_FEATURE_ROOT=/app/dataset_processed only to use the offline files instead.
# SPATIAL_FEATURE_ROOT=/app/dataset_processed
# Railway development writes the cache and keeps 2 windows.
DOWNSCALE_WRITE_CACHE=1
DOWNSCALE_KEEP_WINDOWS=2
THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
ENVIRONMENT=DEV
# Ground truth SPKU (opsional; lihat src/data_worker/README.md)
SPKU_DB_SCHEMA=ground_truth
SPKU_CONTACT=
# SPKU_ARCHIVE_DIR=/data/arsip
# Catatan eksekusi siklus terjadwal (TI-DO-07)
# WORKER_DB_SCHEMA=worker
# WORKER_LOCK_WAIT_SECONDS=600
# Konektor sumber sekunder dan FeatureMatrix (TI-SE-02; lihat feature_store/README.md)
# EARTHDATA_TOKEN=            # token Earthdata Login untuk VIIRS; jangan di-commit
# FEATURES_SOURCES=all
# FEATURES_DB_SCHEMA=features
# FEATURE_STORE_DIR=/data/features
