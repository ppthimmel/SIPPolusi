{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/data_worker/**"]
  },
  "deploy": {
    "startCommand": "python main.py cycle",
    "cronSchedule": "15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
