# Owner: ML platform. MLflow tracking server / model registry.
# Backend store uses schema 'mlflow' on the shared Postgres instance.
MLFLOW_BACKEND_STORE_URI=postgresql://sippolusi:change-me@postgres:5432/sippolusi?options=-csearch_path=mlflow
# Proxied artifacts, as on Railway: clients (Data Worker, Cache API, scripts) send and fetch artifacts
# through this server and need only MLFLOW_TRACKING_URI. Only this service holds object-storage keys.
MLFLOW_ARTIFACT_ROOT=mlflow-artifacts:/
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow/artifacts
# Local object storage is the minio service (path-style URLs). Railway uses its Storage Bucket instead:
# endpoint https://t3.storageapi.dev, virtual-host URLs, a generated bucket name (src/model_registry/README.md).
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
ENVIRONMENT=DEV
