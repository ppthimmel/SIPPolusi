# Owner: frontend.
# BACKEND_UPSTREAM: where the nginx container proxies /v1/* (Railway: the backend's private/public URL).
BACKEND_UPSTREAM=http://backend:8000
# BACKEND_URL: target of the Vite dev-server proxy (npm run dev only).
BACKEND_URL=http://localhost:8000
ENVIRONMENT=DEV
# VITE_BASEMAP_TILES: raster tile URL template for the map background (build time).
# Empty uses tile.openstreetmap.org, fine for development only; use a hosted or
# self-hosted tile service in production (OSM tile usage policy).
# VITE_BASEMAP_TILES=https://tiles.example.com/{z}/{x}/{y}.png
