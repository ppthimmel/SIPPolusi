# Owner: frontend.
# GATEWAY_UPSTREAM: where the nginx container proxies /v1/*, the API Gateway (src/gateway).
# Railway: http://${{gateway.RAILWAY_PRIVATE_DOMAIN}}:${{gateway.PORT}}
GATEWAY_UPSTREAM=http://gateway:8080
# BACKEND_URL: target of the Vite dev-server proxy (npm run dev only).
# :8000 = `npm run mock`. Against the real stack use the API Gateway of
# `docker compose up` (http://localhost:8081): it routes POST /v1/routes and
# GET /v1/exposure-surface to the Cache API.
BACKEND_URL=http://localhost:8000
ENVIRONMENT=DEV
# VITE_BASEMAP_TILES: raster tile URL template for the map background (build time).
# Empty uses tile.openstreetmap.org, fine for development only; use a hosted or
# self-hosted tile service in production (OSM tile usage policy).
# VITE_BASEMAP_TILES=https://tiles.example.com/{z}/{x}/{y}.png
