# Owner: frontend.
# GATEWAY_UPSTREAM: where the nginx container proxies /v1/*, the API Gateway (src/gateway).
# Railway: http://${{gateway.RAILWAY_PRIVATE_DOMAIN}}:${{gateway.PORT}}
GATEWAY_UPSTREAM=http://gateway:8080
# BACKEND_URL: target of the Vite dev-server proxy (npm run dev only).
# :8000 = `npm run mock`. Against the real stack use the API Gateway of
# `docker compose up` (http://localhost:8081): it routes POST /v1/routes,
# GET /v1/exposure-surface and POST /v1/geocode/* to the Cache API.
BACKEND_URL=http://localhost:8000
ENVIRONMENT=DEV
# VITE_BASEMAP_STYLE: MapLibre style JSON for the map background (build time). Empty uses
# OpenFreeMap "liberty": OpenStreetMap vector tiles with place icons and landmarks, free, no key.
# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
# VITE_BASEMAP_TILES: raster tile URL template instead of the vector style (build time).
# VITE_BASEMAP_TILES=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_ROUTE_TIMEOUT_MS / VITE_SURFACE_TIMEOUT_MS: request timeouts in ms (build time).
# docker-compose.yml passes them as build args (45000 each, as on Railway development); these lines
# only matter for npm run dev.
# Empty uses Tabel 3.15: 12000 for POST /v1/routes, 5000 for GET /v1/exposure-surface.
# Keep the route timeout above the gateway's GATEWAY_UPSTREAM_TIMEOUT_S.
# VITE_ROUTE_TIMEOUT_MS=12000
# VITE_SURFACE_TIMEOUT_MS=5000
# Testing tools (build time, or when `npm run dev` starts). Empty = on in `npm run dev`, off in a
# production build. Accepted: true/false, on/off, 1/0, yes/no. Never on for the real public site.
# VITE_NAV_TEST_PANEL: the "Uji navigasi" panel during navigation (leave / return to the route).
# VITE_NAV_TEST_PANEL=true
# VITE_GPS_SPOOF: the GPS spoofer via the URL: ?lokasi=monas (fixed point) and ?simulasi=normal
# (movement along the route while navigating); see docs/frontend-enhancement.
# VITE_GPS_SPOOF=on
