# Koleksi uji API publik SIPPolusi (TI-SE-08). Dibuat dari public_api/smoke.py:
#   python -m public_api.smoke --export-http
# Ganti @host dengan Cache API lokal (docker run -p 8001:8000) atau domain API Gateway.
@host = http://localhost:8001

### Rute jalan kaki Monas → Bundaran HI
# Harapan: 200, 503 cache_unavailable
POST {{host}}/v1/routes
Content-Type: application/json

{
  "origin": {
    "lat": -6.1754,
    "lon": 106.8272
  },
  "destination": {
    "lat": -6.195,
    "lon": 106.823
  },
  "mode": "walk",
  "pollutant": "pm25",
  "preference": {
    "alpha": 0.5,
    "beta": 0.5
  }
}

### Rute sepeda, polutan acuan NO2, utamakan paparan
# Harapan: 200, 503 cache_unavailable
POST {{host}}/v1/routes
Content-Type: application/json

{
  "origin": {
    "lat": -6.1754,
    "lon": 106.8272
  },
  "destination": {
    "lat": -6.195,
    "lon": 106.823
  },
  "mode": "bike",
  "pollutant": "no2",
  "preference": {
    "alpha": 0.2,
    "beta": 0.8
  }
}

### α + β ≠ 1
# Harapan: 400 invalid_request
POST {{host}}/v1/routes
Content-Type: application/json

{
  "origin": {
    "lat": -6.1754,
    "lon": 106.8272
  },
  "destination": {
    "lat": -6.195,
    "lon": 106.823
  },
  "mode": "walk",
  "pollutant": "pm25",
  "preference": {
    "alpha": 0.6,
    "beta": 0.5
  }
}

