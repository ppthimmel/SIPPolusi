    "lat": -6.1225,
    "lon": 106.842
  },
  "destination": {
    "lat": -6.1,
    "lon": 106.842
  },
  "mode": "walk",
  "pollutant": "pm25",
  "preference": {
    "alpha": 0.5,
    "beta": 0.5
  }
}

### Asal = tujuan
# Harapan: 422 no_route_found, 503 cache_unavailable
POST {{host}}/v1/routes
Content-Type: application/json

{
  "origin": {
    "lat": -6.1754,
    "lon": 106.8272
  },
  "destination": {
    "lat": -6.1754,
    "lon": 106.8272
  },
  "mode": "walk",
  "pollutant": "pm25",
  "preference": {
    "alpha": 0.5,
    "beta": 0.5
  }
}

### GET pada /v1/routes
# Harapan: 405 method_not_allowed
GET {{host}}/v1/routes

### Heatmap per ruas, sekitar Monas, zoom 15
# Harapan: 200, 503 cache_unavailable
GET {{host}}/v1/exposure-surface?bbox=106.822,-6.180,106.832,-6.170&zoom=15

### Heatmap grid 500 m, Jakarta Pusat, zoom 12
# Harapan: 200, 503 cache_unavailable
GET {{host}}/v1/exposure-surface?bbox=106.79,-6.22,106.87,-6.15&zoom=12&pollutant=pm25

### Heatmap grid 1 km, seluruh Jakarta, zoom 11
# Harapan: 200, 503 cache_unavailable
GET {{host}}/v1/exposure-surface?bbox=106.68,-6.38,106.98,-6.08&zoom=11

### Seluruh Jakarta pada zoom 15 (terlalu luas)
# Harapan: 400 invalid_request
GET {{host}}/v1/exposure-surface?bbox=106.68,-6.38,106.98,-6.08&zoom=15

### Zoom di luar 0–22
# Harapan: 400 invalid_request
GET {{host}}/v1/exposure-surface?bbox=106.822,-6.180,106.832,-6.170&zoom=23

### bbox hanya 3 angka
# Harapan: 400 invalid_request
GET {{host}}/v1/exposure-surface?bbox=106.82,-6.18,106.83&zoom=15
