# Owner: backend. Cache API (src/backend/osm/Dockerfile): the whole public API behind the gateway
# (POST /v1/routes, GET /v1/exposure-surface, POST /v1/geocode/*) and the internal /v1/osm, /v1/pollution.
# docker-compose.yml reads this file as src/backend/osm/.env. Values follow Railway development.
DATABASE_URL=postgresql://sippolusi:change-me@postgres:5432/sippolusi
PORT=8000
# Route model: the registered MORL policy (TI-SE-07b), resolved from the registry through its artifact
# proxy. Register it locally first: docker compose --profile tools run --rm register_models
# (docs/devops/local-railway-parity.md). Until then requests fall back to the A* baseline.
ROUTE_SOLVER_PROVIDER=morl
MLFLOW_TRACKING_URI=http://model_registry:5000
# ROUTE_SOLVER_MODEL_SELECTOR=production
ROUTE_SOLVER_BUDGET_MS=40000
ROUTE_SOLVER_FALLBACK_TIMEOUT_MS=20000
ROUTE_SOLVER_GATEWAY_TIMEOUT_MS=43000
OSM_COMMAND_TIMEOUT_S=30
OSM_STATEMENT_TIMEOUT_MS=25000
# Place search (TI-SE-12). The public Photon server receives search text and clicked points;
# leave empty to keep them local (search then answers 503 geocoding_unavailable).
API_GEOCODING_URL=https://photon.komoot.io
ENVIRONMENT=DEV
